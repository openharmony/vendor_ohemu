              "//developtools/ace_ets2bundle:ets_loader_ark_hap",
              "//developtools/ace_ets2bundle/koala-wrapper:ohos_ets_koala_wrapper(//build/toolchain/linux:clang_x64)",
              "//developtools/ace_ets2bundle/ets1.2:ohos_ets_libarkts(//build/toolchain/linux:clang_x64)"
            ]
          }
        }
      ]
    },
    {
      "subsystem": "arkcompiler",
      "components": [
        {
          "component": "ets_runtime",
          "features": [],
