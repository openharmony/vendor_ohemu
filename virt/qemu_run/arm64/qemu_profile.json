{
  "schema_version": 1,
  "id": "arm64_linux_full",
  "product_name": "arm64_virt",
  "guest_arch": "aarch64",
  "port_slot": 1,
  "qemu_binaries": ["qemu-system-aarch64"],
  "minimum_qemu_version": "5.1.0",
  "default_image_paths": ["out/arm64_virt/packages/phone/images"],
  "default_instance_root": "out/arm64_virt/qemu_instances",
  "machine_args": ["-machine", "virt"],
  "cpu": "cortex-a57",
  "smp": 4,
  "memory_mib": 4096,
  "kernel": "Image",
  "initrd": "ramdisk.img",
  "common_args": ["-k", "en-us", "-rtc", "base=localtime,clock=host"],
  "graphics": {
    "supported": true,
    "device_args": ["-device", "virtio-gpu-pci,xres=800,yres=500"]
  },
  "input_args": [
    "-device", "virtio-mouse-pci",
    "-device", "virtio-keyboard-pci"
  ],
  "network": {"device": "virtio-net-device"},
  "drives": [
    {"id": "updater", "file": "updater.img", "base_format": "raw", "drive_options": ["if=none", "id=updater"], "device": "virtio-blk-device", "device_options": ["drive=updater", "serial=updater"]},
    {"id": "system", "file": "system.img", "base_format": "raw", "drive_options": ["if=none", "id=system"], "device": "virtio-blk-device", "device_options": ["drive=system", "serial=system"]},
    {"id": "vendor", "file": "vendor.img", "base_format": "raw", "drive_options": ["if=none", "id=vendor"], "device": "virtio-blk-device", "device_options": ["drive=vendor", "serial=vendor"]},
    {"id": "sys_prod", "file": "sys_prod.img", "base_format": "raw", "drive_options": ["if=none", "id=sys_prod"], "device": "virtio-blk-device", "device_options": ["drive=sys_prod", "serial=sys_prod"]},
    {"id": "chip_prod", "file": "chip_prod.img", "base_format": "raw", "drive_options": ["if=none", "id=chip_prod"], "device": "virtio-blk-device", "device_options": ["drive=chip_prod", "serial=chip_prod"]},
    {"id": "userdata", "file": "userdata.img", "base_format": "raw", "drive_options": ["if=none", "id=userdata"], "device": "virtio-blk-device", "device_options": ["drive=userdata", "serial=userdata"]}
  ],
  "bootargs": [
    "default_boot_device=a003e00.virtio_mmio",
    "sn=${INSTANCE_SN}",
    "ip=dhcp",
    "loglevel=4",
    "console=ttyAMA0,115200",
    "init=/bin/init",
    "ohos.boot.hardware=virt",
    "root=/dev/ram0",
    "rw",
    "ohos.required_mount.system=/dev/block/vde@/usr@ext4@ro,barrier=1@wait,required",
    "ohos.required_mount.vendor=/dev/block/vdd@/vendor@ext4@ro,barrier=1@wait,required",
    "ohos.required_mount.sys_prod=/dev/block/vdc@/sys_prod@ext4@rw,barrier=1@wait,required",
    "ohos.required_mount.chip_prod=/dev/block/vdb@/chip_prod@ext4@rw,barrier=1@wait,required",
    "ohos.required_mount.data=/dev/block/vda@/data@ext4@nosuid,nodev,noatime,barrier=1,data=ordered,noauto_da_alloc@wait,reservedsize=104857600"
  ]
}
