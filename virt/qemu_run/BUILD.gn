qemu_image_dir = "$root_build_dir/packages/phone/images"

if (target_cpu == "x86_64") {
  qemu_run_source_dir = "x86_64"
} else if (target_cpu == "arm64") {
  qemu_run_source_dir = "arm64"
} else if (target_cpu == "arm") {
  qemu_run_source_dir = "arm"
} else {
  assert(false, "QEMU launcher does not support target_cpu=${target_cpu}")
}

copy("qemu_run_product_entries") {
  sources = [
    "$qemu_run_source_dir/qemu_profile.json",
    "$qemu_run_source_dir/qemu_run.cmd",
    "$qemu_run_source_dir/qemu_run.sh",
  ]
  outputs = [ "$qemu_image_dir/{{source_file_part}}" ]
}

group("qemu_run_package") {
  deps = [
    ":qemu_run_product_entries",
    "//vendor/ohemu/common:qemu_launcher_common",
  ]
}
