qemu_image_dir = "$root_build_dir/packages/phone/images"

copy("qemu_launcher_common_entries") {
  sources = [
    "README.md",
    "qemu_launcher.py",
  ]
  outputs = [ "$qemu_image_dir/{{source_file_part}}" ]
}

copy("qemu_launcher_common_library") {
  sources = [
    "qemu_launcher_lib/__init__.py",
    "qemu_launcher_lib/launcher.py",
  ]
  outputs = [ "$qemu_image_dir/qemu_launcher_lib/{{source_file_part}}" ]
}

group("qemu_launcher_common") {
  deps = [
    ":qemu_launcher_common_entries",
    ":qemu_launcher_common_library",
  ]
}
